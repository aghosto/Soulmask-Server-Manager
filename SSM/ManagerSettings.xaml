<Window x:Class="SoulmaskServerManager.ManagerSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoulmaskServerManager"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        mc:Ignorable="d"
        Title="管理器设置" Height="600" Width="640" MinHeight="600" MinWidth="640" Icon="Resources\icon_Settings.png" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Click="FileMenuLoad_Click" Margin="2,0" ToolTip="导入管理器完整设置文件">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Download" Margin="0,0,3,0"/>
                    <TextBlock Text="导入"/>
                </StackPanel>
            </Button>
            <Button Click="SaveButton_Click" Margin="2,0" ToolTip="保存管理器设置">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Save" Margin="0,0,3,0"/>
                    <TextBlock Text="保存"/>
                </StackPanel>
            </Button>
            <Button Click="FileMenuExport_Click" Margin="2,0" ToolTip="导出管理器完整设置文件">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="OpenFile" Margin="0,0,3,0"/>
                    <TextBlock Text="导出"/>
                </StackPanel>
            </Button>
            <Button Click="ResetToDefault_Click" Margin="2,0" ToolTip="将此窗口中的选项重置为默认值，保留服务器列表和路径">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Refresh" Margin="0,0,3,0"/>
                    <TextBlock Text="重置为默认"/>
                </StackPanel>
            </Button>
            <Separator Margin="5,0" Width="2" Height="25"/>
            <Button Click="ExitButton_Click" Margin="2,0" ToolTip="关闭设置窗口">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Cancel" Margin="0,0,3,0"/>
                    <TextBlock Text="退出"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Grid.Column="0">
            <DockPanel>
                <TabControl Padding="10" DockPanel.Dock="Top">
                    <TabItem Header="主要设置" RenderTransformOrigin="1.786,0.684">
                        <StackPanel >
                            <GroupBox Header="主要设置" >
                                <DockPanel>
                                    <StackPanel RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left">
                                        <StackPanel.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <SkewTransform AngleX="0.282"/>
                                                <RotateTransform/>
                                                <TranslateTransform X="-1.009"/>
                                            </TransformGroup>
                                        </StackPanel.RenderTransform>
                                        <CheckBox Content="搜索应用程序更新" IsChecked="{Binding AppSettings.AutoUpdateApp, Mode=TwoWay}" ToolTip="SSM是否在启动时检查自身新版本" FontSize="18"/>
                                        <CheckBox Content="服务器更新时验证" IsChecked="{Binding AppSettings.VerifyUpdates, Mode=TwoWay}" ToolTip="SteamCMD更新服务器后是否验证游戏文件完整性，建议启用以修复损坏文件" FontSize="18"/>
                                        <CheckBox Content="显示SteamCMD窗口" IsChecked="{Binding AppSettings.ShowSteamCMDWindow, Mode=TwoWay}" ToolTip="更新服务器时是否显示SteamCMD命令窗口，用于排查更新失败问题" FontSize="18" Margin="0, 10, 0, 0" IsEnabled="True" ToolTipService.ShowOnDisabled="True"/>
                                        <CheckBox Content="启用黑暗模式" IsChecked="{Binding AppSettings.DarkMode, Mode=TwoWay}" ToolTip="切换应用程序的明暗主题" FontSize="18"/>
                                        <CheckBox Content="自动加载设置文件" IsChecked="{Binding AppSettings.AutoLoadEditor, Mode=TwoWay}" ToolTip="设置编辑器是否自动加载当前选中服务器的配置文件" FontSize="18"/>
                                        <CheckBox Content="服务器崩溃重启时保存Log备份" Name="SaveLogWhenCrashCheckBox" IsChecked="{Binding AppSettings.SaveLogWhenCrash}" ToolTip="服务器崩溃或重启时自动备份日志文件到CrashLog目录" FontSize="18"/>
                                        
                                    </StackPanel>
                                    <StackPanel>
                                        <DockPanel Margin="0,15,0,0">
                                            <StackPanel>
                                                <TextBlock Text="关闭按钮行为：" FontSize="18" Margin="5,0,0,5" FontWeight="Medium"/>
                                                <ComboBox 
                                                        x:Name="CloseExecuteSelectCombo" 
                                                        VerticalAlignment="Top" 
                                                        Width="300" 
                                                        Margin="5,0,5,0" 
                                                        OverridesDefaultStyle="True"
                                                        SelectedIndex="{Binding AppSettings.CloseExecuteSelect, Mode=TwoWay}">
                                                    <ComboBoxItem Content="直接退出程序"/>
                                                    <ComboBoxItem Content="最小化到托盘"/>
                                                </ComboBox>
                                                <TextBlock Text="设置点击窗口关闭按钮后的行为" FontSize="12" Margin="5,5,0,0" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        
                                    </StackPanel>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Webhook设置" IsEnabled="False">
                        <GroupBox Header="Webhook设置">
                            <StackPanel>
                                <CheckBox Name="WebhookCheck" Content="启动" IsChecked="{Binding WebhookSettings.Enabled}" ToolTip="启用通过Discord Webhook发送通知消息"/>
                                <DockPanel Margin="0,5,0,0">
                                    <TextBlock Width="75" Text="URL:" VerticalAlignment="Center"/>
                                    <TextBox IsEnabled="{Binding WebhookSettings.Enabled}" Text="{Binding WebhookSettings.URL, Mode=TwoWay}" ToolTip="Discord频道的Webhook URL（在频道设置中创建）"/>
                                </DockPanel>
                                <TextBlock Text="信息" Margin="0,10,0,0" FontSize="20"/>
                                <DockPanel Margin="0,5,0,0">
                                    <TextBlock Width="100" Text="已找到更新：" VerticalAlignment="Center"/>
                                    <TextBox IsEnabled="{Binding IsChecked, ElementName=WebhookCheck}" Text="{Binding WebhookSettings.UpdateFound, Mode=TwoWay}" ToolTip="检测到游戏服务器更新时发送的通知（留空禁用）" ToolTipService.ShowOnDisabled="True"/>
                                </DockPanel>
                                <DockPanel Margin="0,5,0,0">
                                    <TextBlock Width="100" Text="更新等待时间：" VerticalAlignment="Center"/>
                                    <TextBox IsEnabled="{Binding IsChecked, ElementName=WebhookCheck}" Text="{Binding WebhookSettings.UpdateWait, Mode=TwoWay}" ToolTip="服务器将在5分钟后关闭更新时发送的通知（留空禁用）" ToolTipService.ShowOnDisabled="True"/>
                                </DockPanel>
                                <Button Content="重置" Width="100" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetButton_Click" ToolTip="将所有Webhook消息恢复为默认文本"/>
                                <Separator Margin="0,10,0,10"/>
                                <GroupBox Header="自定义服务器消息">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="选择要自定义的服务器：" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                            <ComboBox Name="ServerCombo1" ItemsSource="{Binding Servers}" DisplayMemberPath="ssmServerName" Width="250"/>
                                            <Button Content="重置" Name="ResetServerButton" Width="100" HorizontalAlignment="Left" Margin="10,0,0,0" Click="ResetServerButton_Click" ToolTip="将当前服务器的消息恢复为默认文本"/>
                                        </DockPanel>
                                        <StackPanel Margin="0,10,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=ServerCombo1, Path=SelectedItem}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <CheckBox Content="启用" DataContext="{Binding SelectedItem, ElementName=ServerCombo1}" IsChecked="{Binding WebhookMessages.Enabled}" IsEnabled="{Binding IsChecked, ElementName=WebhookCheck}" ToolTip="启用当前服务器的Webhook通知" ToolTipService.ShowOnDisabled="True"/>
                                            <DockPanel Margin="0,5,0,0">
                                                <TextBlock Text="服务器正在启动：" Width="150" VerticalAlignment="Center"/>
                                                <TextBox DataContext="{Binding SelectedItem, ElementName=ServerCombo1}" IsEnabled="{Binding IsChecked, ElementName=WebhookCheck}" Text="{Binding WebhookMessages.StartServer}" ToolTip="服务器启动时发送的通知（留空禁用）" ToolTipService.ShowOnDisabled="True"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,5,0,0">
                                                <TextBlock Text="服务器正在停止：" Width="150" VerticalAlignment="Center"/>
                                                <TextBox DataContext="{Binding SelectedItem, ElementName=ServerCombo1}" IsEnabled="{Binding IsChecked, ElementName=WebhookCheck}" Text="{Binding WebhookMessages.StopServer}" ToolTip="服务器停止时发送的通知（留空禁用）" ToolTipService.ShowOnDisabled="True"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,5,0,0">
                                                <TextBlock Text="服务器就绪：" Width="150" VerticalAlignment="Center"/>
                                                <TextBox DataContext="{Binding SelectedItem, ElementName=ServerCombo1}" IsEnabled="{Binding IsChecked, ElementName=WebhookCheck}" Text="{Binding WebhookMessages.ServerReady}" ToolTip="服务器启动完成时发送的通知（留空禁用）" ToolTipService.ShowOnDisabled="True"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,5,0,0">
                                                <TextBlock Text="3次启动尝试：" Width="150" VerticalAlignment="Center"/>
                                                <TextBox DataContext="{Binding SelectedItem, ElementName=ServerCombo1}" IsEnabled="{Binding IsChecked, ElementName=WebhookCheck}" Text="{Binding WebhookMessages.AttemptStart3, Mode=OneWay}" ToolTip="服务器连续3次启动失败时发送的通知（留空禁用）" ToolTipService.ShowOnDisabled="True"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,5,0,0">
                                                <TextBlock Text="服务器崩溃：" Width="150" VerticalAlignment="Center"/>
                                                <TextBox DataContext="{Binding SelectedItem, ElementName=ServerCombo1}" IsEnabled="{Binding IsChecked, ElementName=WebhookCheck}" Text="{Binding WebhookMessages.ServerCrash}" ToolTip="服务器崩溃时发送的通知（留空禁用）" ToolTipService.ShowOnDisabled="True"/>
                                            </DockPanel>
                                            <CheckBox Content="播送IP" DataContext="{Binding SelectedItem, ElementName=ServerCombo1}" IsEnabled="{Binding IsChecked, ElementName=WebhookCheck}" IsChecked="{Binding WebhookMessages.BroadcastIP}" ToolTip="服务器就绪通知中是否包含服务器IP地址" ToolTipService.ShowOnDisabled="True"/>
                                            <CheckBox Content="播送SteamID" DataContext="{Binding SelectedItem, ElementName=ServerCombo1}" IsEnabled="{Binding IsChecked, ElementName=WebhookCheck}" IsChecked="{Binding WebhookMessages.BroadcastSteamID}" ToolTip="服务器就绪通知中是否包含服务器SteamID" ToolTipService.ShowOnDisabled="True"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </GroupBox>
                    </TabItem>

                    <TabItem Header="服务器设置" IsEnabled="True">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="选择要自定义的服务器：" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <ComboBox Name="ServerCombo2" ItemsSource="{Binding Servers}" DisplayMemberPath="ssmServerName" Width="250"/>
                            </DockPanel>
                            <Separator Margin="0,10,0,10"/>
                            <GroupBox Header="RCON">
                                <ScrollViewer x:Name="RconMessagesScrollViewer" MinHeight="100" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="RconMessagesScrollViewer_PreviewMouseWheel">
                                    <StackPanel DataContext="{Binding SelectedItem, ElementName=ServerCombo2}">
                                    <CheckBox Name="RCONCheck" Content="启用定时消息" IsChecked="{Binding RconServerSettings.Enabled, Mode=TwoWay}" ToolTip="服务器运行时按设定间隔通过 RCON 向游戏内发送消息"/>

                                    <TextBlock Text="定时消息（每条可单独设定间隔）：" Margin="0,8,0,2"/>
                                    <ItemsControl ItemsSource="{Binding RconServerSettings.ScheduledMessages}" IsEnabled="{Binding RconServerSettings.Enabled}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Padding="5" Margin="0,3">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <Button Content="删除" DockPanel.Dock="Right" Padding="5,1" Click="RemoveScheduledMessage_Click"/>
                                                            <TextBlock Text="消息内容：" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                        <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="36" ToolTip="通过 RCON 的 Say 命令发送到游戏聊天中的内容"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="间隔（分钟）：" VerticalAlignment="Center"/>
                                                            <ui:NumberBox Value="{Binding IntervalMinutes, Mode=TwoWay}" Minimum="1" Maximum="1440" Width="100" SpinButtonPlacementMode="Inline"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="添加定时消息" HorizontalAlignment="Left" Margin="0,4,0,0" Click="AddScheduledMessage_Click" IsEnabled="{Binding RconServerSettings.Enabled}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>
                            <GroupBox Header="定时自动重启">
                                <StackPanel DataContext="{Binding SelectedItem, ElementName=ServerCombo2}">
                                    <CheckBox x:Name="ScheduledAutoRestartCheck" Content="启用该服务器的每日自动重启" IsChecked="{Binding ScheduledAutoRestartEnabled, Mode=TwoWay}" ToolTip="只重启当前选中的服务器；崩溃后自动重启为另一项设置"/>
                                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=ScheduledAutoRestartCheck}">
                                        <ui:NumberBox Value="{Binding ScheduledAutoRestartHour, Mode=TwoWay}" Minimum="0" Maximum="23" PlaceholderText="00" Width="75"/>
                                        <TextBlock Text="时" VerticalAlignment="Center"/>
                                        <ui:NumberBox Value="{Binding ScheduledAutoRestartMin, Mode=TwoWay}" Minimum="0" Maximum="59" PlaceholderText="00" Width="75"/>
                                        <TextBlock Text="分" VerticalAlignment="Center"/>
                                        <ui:NumberBox Value="{Binding ScheduledAutoRestartSec, Mode=TwoWay}" Minimum="0" Maximum="59" PlaceholderText="00" Width="75"/>
                                        <TextBlock Text="秒" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="自动更新">
                                <StackPanel DataContext="{Binding SelectedItem, ElementName=ServerCombo2}">
                                    <CheckBox Content="自动检查并更新此服务器" IsChecked="{Binding AutoUpdateEnabled, Mode=TwoWay}" ToolTip="启用后按下方全局间隔检查并自动更新此服务器"/>
                                    <StackPanel Orientation="Horizontal" Margin="22,2,0,0">
                                        <TextBlock Text="所有服务器的检查间隔（分钟）：" VerticalAlignment="Center"/>
                                        <ui:NumberBox Value="{Binding DataContext.AppSettings.AutoUpdateGameInterval, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}" Maximum="1440" Minimum="1" SpinButtonPlacementMode="Hidden" Width="120" Margin="8,0,0,0" ToolTip="全局自动检查间隔，所有启用自动更新的服务器共用此间隔"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="自动启动">
                                <StackPanel>
                                    <CheckBox x:Name="AutoStartCheck" Content="自动启动" DataContext="{Binding SelectedItem, ElementName=ServerCombo2}" IsChecked="{Binding AutoStart}" ToolTip="SSM启动时是否自动启动该服务器"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </ScrollViewer>
    </Grid>
</Window>
