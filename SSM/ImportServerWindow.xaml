<Window x:Class="SoulmaskServerManager.ImportServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoulmaskServerManager" 
        xmlns:ui="http://schemas.modernwpf.com/2019" xmlns:local1="clr-namespace:SoulmaskServerManager.Controls"
        ui:WindowHelper.UseModernWindowStyle="True"
        mc:Ignorable="d"
        Title="服务器导入窗口" Height="320" Width="650" MinWidth="560" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="选择文件夹..." Padding="10,4" Click="BrowseSourceButton_Click"/>
            <TextBlock Text="源服务器路径：" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SourcePathTextBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="目标服务器路径：" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TargetPathTextBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
        </DockPanel>
        <Border
            Grid.Row="2"
            x:Name="DropArea"
            AllowDrop="True"
            Drop="DropArea_Drop"
            DragEnter="DropArea_DragEnter"
            DragLeave="DropArea_DragLeave"
            Background="White"
            BorderBrush="#FF888888"
            BorderThickness="1"
            CornerRadius="4">

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ImportProgressText"
                    Text="拖入服务器文件夹到这里，也可以使用上方按钮选择"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    FontSize="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                <TextBlock x:Name="ImportFileText"
                    Visibility="Collapsed"
                    TextTrimming="CharacterEllipsis"
                    Margin="12,12,12,4"
                    HorizontalAlignment="Center"/>
                <ProgressBar x:Name="ImportProgressBar"
                    Visibility="Collapsed"
                    Minimum="0"
                    Maximum="100"
                    Height="12"
                    Margin="16,0,16,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
